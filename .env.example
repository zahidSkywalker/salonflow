# SalonFlow environment (all optional — the app runs with zero config)

# SQLite database location.
# When unset, SalonFlow uses ./db/custom.db (a seeded demo database ships with the repo).
# Use an absolute path for production installs, e.g.:
#   DATABASE_URL="file:/var/data/salonflow.db"
#
# On serverless hosts (Vercel) SalonFlow automatically uses a writable /tmp database,
# creates the schema and seeds fresh demo data on cold start.
#
# DATABASE_URL="file:./db/custom.db"

# No other environment variables are required.
# Admin PIN, salon name, branding, hours and currency are managed inside the app:
# Admin panel -> Settings.
